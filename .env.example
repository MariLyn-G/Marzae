# Copy to .env.local for development. Only DATABASE_URL matters locally; the rest have dev defaults.

DATABASE_URL=postgresql://marzae:marzae@localhost:5432/marzae

# Signs session cookies. Required in production: `openssl rand -base64 32`
AUTH_SECRET=

# Public origin, used in sign-in links, emails and Stripe redirects.
APP_URL=http://localhost:3000

# Comma-separated emails with back-office access. Dev default: atelier@marzae.test
ATELIER_EMAILS=

# Stripe. Without a secret key, checkout places unpaid orders (dev only, or ALLOW_UNPAID_ORDERS=1).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_UNPAID_ORDERS=

# Email through Resend. Without a key, emails are printed to the server console.
RESEND_API_KEY=
MAIL_FROM=Marzae <atelier@your-domain.com>

# The currency this deployment sells and charges in (EUR, USD or GBP). Build-time.
# Prices come from the atelier price list for this currency; items without a price there are not for sale.
NEXT_PUBLIC_CURRENCY=EUR
NEXT_PUBLIC_SHOP_GRID=3
